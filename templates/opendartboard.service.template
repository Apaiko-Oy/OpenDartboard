[Unit]
Description=OpenDartboard 3-cam scorer
# Ordered against connectivity rather than against the networking subsystem (#1334).
# After=network.target only means the stack has been brought up; it says nothing about an
# address or a route existing, so the detector could start before the board had one. The
# pair that waits for connectivity is Wants= and After= on network-online.target.
#
# Wants= is deliberately weak and stays weak: a board with no network is still a board that
# can see darts and spool them, so this orders the start and must never block it. Do not
# promote it to Requires= -- that would make the detector depend on the network, which is a
# different decision than this one.
Wants=network-online.target
After=network-online.target
# A detector that exits repeatedly must stop and say so, not loop. Five starts inside a
# minute is a detector that cannot stay up; systemd then refuses the sixth, fails the unit
# and writes "start request repeated too quickly" to the journal, instead of re-running
# calibration forever. Written here rather than inherited from DefaultStartLimitIntervalSec
# and DefaultStartLimitBurst, which belong to whatever image flashed the card and not to
# this unit.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# ---- #1801: HOW A PACKAGED BOARD STARTS ----
#
# --autocams, not a fixed camera list. A USB camera may expose two video nodes, the even one
# capturing and the odd one metadata (three Realtek 0bda:5844 on a Pi 5 are /dev/video0, 2
# and 4), so the fixed list this line carried until #1801 faulted that board on its first
# boot. --autocams opens whichever three negotiate MJPG. --cams is still there for an
# operator who writes a drop-in (`systemctl edit opendartboard`: an empty ExecStart= and
# their own), which replaces this line whole, as drop-ins do.
#
# The log file, one per start. The #1787 upload runs only for a board that writes a log,
# and the server keys what it holds by the file's leaf name and a byte offset in it, so a
# file rotated under a constant name would hand it bytes at offsets it already holds. Each
# start therefore names a new file by its UTC start time,
#
#   /var/lib/opendartboard/logs/current/opendartboard-20261011T201500Z.log
#
# and says which in the journal. The shell does only that: it moves the previous start's
# file from current/ up to logs/, picks the name, and execs the detector, so the detector
# is still this unit's main process (NotifyAccess=main below) and the flags after the
# quoted script are the detector's own, handed through as "$@". `$$` and `%%` are systemd's
# escapes for a literal dollar and percent sign. Nothing in it can stop the detector
# starting: the housekeeping is joined by `;`, and a log directory that cannot be made
# turns the detector's file logging off (logging.hpp), never the board.
#
# The pruning is /usr/lib/tmpfiles.d/opendartboard.conf (distributions/debian_arm64/
# tmpfiles.conf): files in logs/ older than seven days go, and logs/current/ is excluded,
# so the newest file -- this start's, or the last start's on a board that has not come up
# since -- is never pruned, whatever the clock says.
ExecStart=/bin/sh -c 'logs=/var/lib/opendartboard/logs; mkdir -p "$$logs/current"; \
    for old in "$$logs"/current/*.log; do [ ! -e "$$old" ] || mv -f "$$old" "$$logs/"; done; \
    file="$$logs/current/opendartboard-$$(date -u +%%Y%%m%%dT%%H%%M%%SZ).log"; \
    echo "opendartboard: this start logs to $$file"; \
    exec /usr/local/bin/opendartboard "$$@" --log-file "$$file"' opendartboard \
    --autocams \
    --width ${WIDTH} --height ${HEIGHT} --fps ${FPS} \
    --model /usr/local/share/opendartboard/models/dart.param
Restart=always
# lock_cams.service.template's number, taken unchanged: the convention is already one file
# over. Without it systemd's default is 100ms, so a crashing detector respawned ten times a
# second and re-ran calibration on every one of them.
RestartSec=2
# ---- #1383: WHAT THE THREE KEYS ABOVE DO NOT COVER, SAID HERE RATHER THAN DISCOVERED ----
#
# Restart=, RestartSec= and the StartLimit pair all fire on EXIT. THE COMMONEST WAY FOR
# THIS BOARD TO BE BROKEN IS NOT AN EXIT. A detector whose cameras will not open, or whose
# calibration fails, takes #895's fault vigil: it stays up, beats ERROR to Turnaus and
# waits, because a camera that comes back should find it still there. So it is never
# restarted, the start limit never counts it, nothing is written to the journal, and this
# unit is `active (running)` for a board that can see nothing.
#
# That is deliberate and it is NOT what the stanza above appears to promise, which is why
# this comment exists. The blind board is made visible by NotifyAccess= below instead --
# it says so in its own `Status:` line -- and not by being made to exit, which would hand
# Restart= a board to loop on and take away the thing the vigil is for.
#
# WatchdogSec= is deliberately absent for the same reason: a missed ping makes systemd
# KILL the service, so a watchdog here would be that exit arriving by a side door.
#
# OD_MAX_CYCLES DOES NOW END A BLIND RUN, AND IT MUST NEVER APPEAR IN THIS FILE. It is a
# tester's instruction -- a run with a known end -- and a board at a venue has no such
# budget. testers/i1383_units.sh fails the tree if this template ever names it.
#
# The board's own word about itself, where a supervisor can read it without opening a log:
#
#   systemctl status opendartboard          ->  Status: "ERROR: this board cannot see -- ..."
#   systemctl show -p StatusText opendartboard
#
# `main` here and not `all`: the detector is the main process on a Linux board -- the
# launcher is Windows-only -- so nothing else has anything to say. Type= stays `simple`:
# MEASURED on systemd 255 (testers/i1383_units.sh), a simple unit with NotifyAccess set
# has $NOTIFY_SOCKET and its STATUS= is kept and printed, so nothing about when this unit
# counts as started moves.
NotifyAccess=main
# ---- #1660: WHERE THIS BOARD KEEPS WHAT IT WAS GIVEN ----
#
# This unit sets no User=, and systemd gives a system unit with no User= neither $HOME nor
# $XDG_CONFIG_HOME, so od_paths::configDir() had nothing to build on. Its callers then
# joined "" onto a leaf: the update channel and the camera choice were written into the
# working directory -- which for a unit is `/` -- and a pairing spent its code and then
# threw the credential away, because it could not create a directory named "".
#
# StateDirectory= makes systemd create /var/lib/opendartboard before every start, owned by
# root and mode 0700 as said below, and export it as $STATE_DIRECTORY, which configDir()
# now reads first. WorkingDirectory= is that same directory, so what the detector keeps
# relative to where it runs -- score_token, cache/, debug_frames/ -- is in it too, and not
# in `/`. One directory is then everything a board holds (ADR-0083 §6), and clearing a
# board by hand is that directory plus the NetworkManager connection (§10a).
#
# Somebody at a terminal is not this unit, and sudo gives them root's $HOME: a bare
# `sudo opendartboard --pair <code>` writes /root/.config/opendartboard, where this unit
# never looks. By hand, say where the unit keeps it:
#
#   sudo STATE_DIRECTORY=/var/lib/opendartboard opendartboard --pair <code>
#   sudo sh -c 'cd /var/lib/opendartboard && opendartboard --show-token'
StateDirectory=opendartboard
StateDirectoryMode=0700
WorkingDirectory=/var/lib/opendartboard
Nice=-5
Environment=G_MESSAGES_MIN_LEVEL=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
